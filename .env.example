APP_ENV=production
APP_DEBUG=false
APP_URL=https://backend.lityourcandle.com
APP_TIMEZONE=Asia/Riyadh

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lityourcandle
DB_USER=lityc
DB_PASS=change_me
DB_CHARSET=utf8mb4

JWT_SECRET=replace_with_64_byte_random_hex
JWT_TTL=2592000

# 256-bit hex key for AES-256-GCM encryption of sensitive notes
NOTES_ENCRYPTION_KEY=replace_with_64_hex_chars

# Apple
APPLE_SHARED_SECRET=
APPLE_VERIFY_URL=https://buy.itunes.apple.com/verifyReceipt
APPLE_VERIFY_SANDBOX_URL=https://sandbox.itunes.apple.com/verifyReceipt

# Google Play
GOOGLE_PLAY_PACKAGE=app.lityourcandle
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/lityourcandle/google-service-account.json

# WebRTC (Agora)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# AI provider (Anthropic by default)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Push notifications
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.lityourcandle
APNS_KEY_PATH=/etc/lityourcandle/AuthKey.p8

# Rate limit (requests per minute per IP+route)
RATE_LIMIT_PER_MIN=120

# WebSocket
WS_PORT=8081
